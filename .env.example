ECHOFORGE_ENV=dev
ECHOFORGE_TIMEZONE=Asia/Kolkata

# YouTube chart scraping
YOUTUBE_CHARTS_URL=https://charts.youtube.com/charts/TopSongs/global/weekly
MAX_SONGS=100

# Optional API keys
GENIUS_ACCESS_TOKEN=your_genius_access_token_here

# App ports
WEBEDITOR_BACKEND_HOST=127.0.0.1
WEBEDITOR_BACKEND_PORT=8765

# MuseVault
LRCLIB_BASE_URL=https://lrclib.net
MUSEVAULT_POPUP_REVIEW=1
